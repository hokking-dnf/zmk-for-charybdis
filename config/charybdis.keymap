#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Layertogle {
            bindings = <&tog 5>;
            key-positions = <30 19>;
        };

        leftclick {
            bindings = <&mkp LCLK>;
            key-positions = <43 44>;
        };

        rightclick {
            bindings = <&mkp RCLK>;
            key-positions = <44 45>;
        };

        q {
            bindings = <&kp COMMA>;
            key-positions = <25 14>;
            require-prior-idle-ms = <111>;
            timeout-ms = <35>;
        };

        w {
            bindings = <&kp F4>;
            key-positions = <25 15>;
            timeout-ms = <35>;
            require-prior-idle-ms = <111>;
        };

        e {
            bindings = <&kp F3>;
            key-positions = <25 16>;
            timeout-ms = <35>;
            require-prior-idle-ms = <111>;
        };

        a {
            bindings = <&kp I>;
            key-positions = <25 26>;
            timeout-ms = <35>;
            require-prior-idle-ms = <111>;
        };

        s {
            bindings = <&kp F7>;
            key-positions = <25 27>;
            timeout-ms = <35>;
            require-prior-idle-ms = <111>;
        };

        d {
            bindings = <&kp F8>;
            key-positions = <25 28>;
            timeout-ms = <35>;
            require-prior-idle-ms = <111>;
        };

        x {
            bindings = <&kp EQUAL>;
            key-positions = <25 39>;
            timeout-ms = <35>;
            require-prior-idle-ms = <111>;
        };

        c {
            bindings = <&kp RBKT>;
            key-positions = <25 40>;
            timeout-ms = <35>;
            require-prior-idle-ms = <111>;
        };

        v {
            bindings = <&kp F12>;
            key-positions = <25 41>;
            timeout-ms = <35>;
            require-prior-idle-ms = <111>;
        };

        scrolllayer {
            bindings = <&mo 3>;
            key-positions = <3 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC       &kp N1          &kp N2  &lt 3 N3  &kp N4            &kp N5          &kp N6      &kp N7           &kp N8           &kp N9           &kp N0        &kp BACKSPACE
&kp TAB       &kp Q           &kp W   &kp E     &kp R             &kp T           &kp Y       &kp U            &kp KP_NUMBER_8  &kp O            &kp P         &kp BSLH
&kp CAPSLOCK  &kp A           &kp S   &kp D     &kp F             &kp G           &kp H       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS   &kp SQT
&kp LCTRL     &kp LEFT_SHIFT  &kp Z   &kp X     &kp C             &kp V           &kp N       &kp F10          &kp F11          &kp F12          &kp KP_ENTER  &kp RIGHT_SHIFT
                                      &kp X     &kp SPACE         &kp H           &kp DELETE  &kp KP_N0
                                                &lt 1 LEFT_SHIFT  &kp LEFT_ALT    &kp ENTER
            >;
        };

        F_layers {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5   &kp F6    &kp F7     &kp F8     &kp F9    &kp F10       &kp F11    &kp F12
&trans  &none   &kp F2  &kp F3  &none    &trans    &none      &none      &kp UP    &kp UP_ARROW  &kp MINUS  &kp EQUAL
&trans  &none   &kp F7  &kp F8  &none    &trans    &mkp LCLK  &kp LEFT   &kp DOWN  &kp RIGHT     &kp RIGHT  &trans
&trans  &trans  &none   &none   &kp F12  &none     &none      &none      &trans    &trans        &none      &trans
                        &trans  &trans   &trans    &mkp LCLK  &mkp RCLK
                                &trans   &none     &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK  &mkp RCLK
                                &trans  &trans    &trans
            >;
        };

        Typing {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3     &kp N4     &kp N5      &kp N6     &kp N7     &kp N8  &kp N9     &kp N0      &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E      &kp R      &kp T       &kp Y      &kp U      &kp I   &kp O      &kp P       &kp BSLH
&kp CAPS   &kp A   &kp S   &kp D      &kp F      &kp G       &kp H      &kp J      &kp K   &kp L      &kp SEMI    &kp APOS
&kp LSHFT  &kp Z   &kp X   &kp C      &kp V      &kp B       &kp B      &kp N      &kp M   &kp COMMA  &kp PERIOD  &kp FSLH
                           &kp LCTRL  &kp SPACE  &trans      &trans     &kp ENTER
                                      &trans     &kp LGUI    &kp LANG1
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
